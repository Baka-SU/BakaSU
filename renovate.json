{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePresets": ["workarounds:javaLTSVersions"],
  "timezone": "Asia/Shanghai",
  "addLabels": ["dependencies"],
  "commitMessagePrefix": "deps:",
  "schedule": [
	"on Monday"
  ],
  "packageRules": [
    {
      "matchManagers":["maven","gradle"],
      "sourceDirectory": "./manager",
      "groupName": "maven-dependencies in manager",
      "labels": ["manager","java"]
    },
    {
      "matchManagers":["cargo"],
      "sourceDirectory": "./userspace/ksud",
      "groupName": "rust-dependencies in ksud",
      "labels": ["rust"]
    },
        {
      "matchManagers":["cargo"],
      "sourceDirectory": "./userspace/ksuinit",
      "groupName": "rust-dependencies in ksuinit",
      "labels": ["rust"]
    },
    {
      "matchCategories":["ci"],
      "matchDepTypes":["action"],
      "matchDatasources":["github-tags"],
      "matchUpdateTypes":"major",
      "groupName": "action-dependencies",
      "labels": ["github-actions"]
    }
  ]
}
