<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".ui.webui.WebUIActivity"
            android:autoRemoveFromRecents="true"
            android:documentLaunchMode="intoExisting"
            android:taskAffinity="${applicationId}.webui"
            android:exported="false"
            android:theme="@style/Theme.KernelSU.WebUI"
            android:configChanges="density|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|locale|layoutDirection|fontScale|keyboard|keyboardHidden"
            />

        <!-- Opened internally after Bluetooth app authentication, never by an exported deep link. -->
        <activity
            android:name=".ui.webui.RemoteWebUIActivity"
            android:launchMode="singleTask"
            android:autoRemoveFromRecents="true"
            android:taskAffinity="${applicationId}.webui"
            android:exported="false"
            android:theme="@style/Theme.KernelSU.WebUI"
            android:configChanges="density|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|locale|layoutDirection|fontScale|keyboard|keyboardHidden" />
        <activity android:name=".ui.webui.BridgeRequestActivity" android:exported="false" android:theme="@style/Theme.KernelSU" />
        <activity android:name=".ui.webui.WearBridgeSetupActivity" android:exported="false" android:theme="@style/Theme.KernelSU" />

        <activity
            android:name=".ui.screen.themeSettings.crop.BackgroundCropActivity"
            android:exported="false"
            android:theme="@style/Theme.KernelSU" />
    </application>
</manifest>
